@model PetGrooming.Models.UpdatePasswordVM
@{ ViewBag.Title = "Change Password"; }
<div class="card narrow">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Current"></label>
        <div class="pwd-wrap">
            <input asp-for="Current" autocomplete="current-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span asp-validation-for="Current" class="field-error"></span>

        <label asp-for="New"></label>
        <div class="pwd-wrap">
            <input asp-for="New" autocomplete="new-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span class="sub">At least 8 characters, with at least one letter and one number.</span>
        <span asp-validation-for="New" class="field-error"></span>

        <label asp-for="Confirm"></label>
        <div class="pwd-wrap">
            <input asp-for="Confirm" autocomplete="new-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span asp-validation-for="Confirm" class="field-error"></span>

        <button class="btn" type="submit">Change Password</button>
        <a class="btn ghost" asp-action="Index">Back to My Account</a>
    </form>
</div>
@section foot {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js"></script>
}

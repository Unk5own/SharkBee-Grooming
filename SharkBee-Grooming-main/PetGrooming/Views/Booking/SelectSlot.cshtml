@model PetGrooming.Models.SelectSlotVM
@{
    var service = (PetGrooming.Models.Service)ViewBag.Service;
    ViewBag.Title = "Select Date & Time";
}

<style>
    /* 1. Fixes the messy layout by using a structured grid */
    .slot-grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
        margin-top: 15px;
    }

    /* 2. Fixes the selection issue by making the active button clearly highlighted */
    #slotGrid button.active {
        background-color: #0f766e;
        color: white;
        border-color: #0f766e;
        font-weight: bold;
    }
</style>

<div style="margin-bottom: 20px;">
    <a asp-action="Catalog" class="btn ghost">&larr; Back to catalog</a>
</div>

<div class="card">
    <b>@service.Name</b> &middot; RM @service.Price.ToString("N2")
    <span class="sub">@service.DurationMinutes minutes &middot; @service.Description</span>
</div>

<form asp-action="AddToCart" method="post">
    @Html.AntiForgeryToken()

    <!-- Hidden inputs that send the selected data to the cart -->
    <input type="hidden" name="ServiceId" value="@service.Id">
    <input type="hidden" id="SelectedSlotStart" name="SlotStart" value="">
    <input type="hidden" id="SelectedStaffEmail" name="StaffEmail" value="">

    <div class="card">
        <div>
            <label asp-for="PetId">Select Pet</label>
            <select asp-for="PetId" asp-items="ViewBag.PetList" required>
                <option value="">-- Choose a pet --</option>
            </select>
        </div>

        <div>
            <label>Preferred Groomer</label>
            <select id="staffSelect" asp-items="ViewBag.StaffList">
                <option value="">Any Groomer</option>
            </select>
        </div>

        <div>
            <label asp-for="Date">Booking Date</label>
            <input type="date" asp-for="Date" id="dateSelect" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required>
        </div>
    </div>

    <div class="card">
        <b>Available Slots</b>
        <div id="slotGrid" class="slot-grid-container">
            <p class="sub" style="grid-column: 1 / -1;">Select a pet and date to load available time slots.</p>
        </div>
    </div>

    <button type="submit" id="submitBtn" class="btn" style="width:100%" disabled>Add to Booking Cart</button>
</form>

@section foot {
    <script>
        const serviceId = "@service.Id";
        const staffSelect = document.getElementById('staffSelect');
        const dateSelect = document.getElementById('dateSelect');
        const slotGrid = document.getElementById('slotGrid');
        const slotInput = document.getElementById('SelectedSlotStart');
        const staffInput = document.getElementById('SelectedStaffEmail');
        const submitBtn = document.getElementById('submitBtn');

        function fetchSlots() {
            const staff = staffSelect.value;
            const date = dateSelect.value;

            // Do not fetch until a date is actually selected
            if (!date) return;

            slotGrid.innerHTML = "<span style='grid-column: 1 / -1;'>Loading slots...</span>";
            submitBtn.disabled = true;
            slotInput.value = "";
            staffInput.value = "";

            fetch(`/Booking/GetAvailableSlots?serviceId=${serviceId}&staffEmail=${staff}&date=${date}`)
                .then(res => res.json())
                .then(slots => {
                    slotGrid.innerHTML = "";
                    if (slots.length === 0) {
                        slotGrid.innerHTML = "<p class='empty' style='grid-column: 1 / -1;'>No slots available for this date. Try another date or groomer.</p>";
                        return;
                    }

                    slots.forEach(s => {
                        const btn = document.createElement('button');
                        btn.type = "button";

                        // Apply styling based on availability
                        btn.className = s.isAvailable ? "btn ghost" : "btn ghost disabled";
                        btn.disabled = !s.isAvailable;

                        // Format time neatly
                        const timeStr = new Date(s.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                        // Show groomer name on a second line if space allows
                        btn.innerHTML = `${timeStr} <br><small style="font-weight:normal;">${s.staffName}</small>`;

                        btn.onclick = () => {
                            // 1. Remove active class from all buttons
                            document.querySelectorAll('#slotGrid button').forEach(b => b.classList.remove('active'));

                            // 2. Add active class to the clicked button
                            btn.classList.add('active');

                            // 3. Populate the hidden fields so the form submits correctly to AddToCart
                            slotInput.value = s.startTime;
                            staffInput.value = s.staffEmail;

                            // 4. Enable the submit button
                            submitBtn.disabled = false;
                        };

                        slotGrid.appendChild(btn);
                    });
                })
                .catch(err => {
                    console.error("Error fetching slots:", err);
                    slotGrid.innerHTML = "<p class='empty' style='grid-column: 1 / -1; color: red;'>Failed to load slots. Please try again.</p>";
                });
        }

        staffSelect.addEventListener('change', fetchSlots);
        dateSelect.addEventListener('change', fetchSlots);

        // Try to fetch on initial load if a date happens to be pre-filled
        fetchSlots();
    </script>
}
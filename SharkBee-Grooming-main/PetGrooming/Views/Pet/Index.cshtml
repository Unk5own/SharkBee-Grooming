@model IEnumerable<PetGrooming.Models.Pet>
@{
    ViewBag.Title = "My Pets";
}

<div class="toolbar">
    <a asp-action="Create" class="btn">Add New Pet</a>
</div>

@if (!Model.Any())
{
    <p class="empty">You haven't added any pets yet.</p>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 20px;">
        @foreach (var pet in Model)
        {
            var primaryPhoto = pet.Photos.FirstOrDefault(p => p.IsPrimary)?.PhotoURL ?? pet.Photos.FirstOrDefault()?.PhotoURL;

            <div class="card" style="display: flex; flex-direction: column; height: 100%; padding: 0; overflow: hidden;">
                <div style="height: 180px; width: 100%; background-color: #f3f4f6; position: relative;">
                    @if (!string.IsNullOrEmpty(primaryPhoto))
                    {
                        <img src="~/photos/pets/@primaryPhoto" alt="@pet.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #9ca3af; font-size: 3rem;">
                            🐾
                        </div>
                    }
                </div>

                <div style="padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <h3 style="margin: 0 0 5px 0;">@pet.Name</h3>
                        <p class="sub" style="margin: 0 0 10px 0;">
                            <b>@pet.Species</b> &middot; @pet.Breed
                        </p>
                        <p style="margin: 0 0 5px 0; font-size: 0.9rem;">
                            <b>Birth Date:</b> @pet.BirthDate.ToString("d MMM yyyy")
                        </p>
                        <p style="margin: 0 0 5px 0; font-size: 0.9rem;">
                            <b>Weight:</b> @pet.WeightKg kg
                        </p>
                        <p style="margin: 0 0 10px 0; font-size: 0.9rem;">
                            <b>Allergies:</b> @(string.IsNullOrWhiteSpace(pet.Allergies) ? "None" : pet.Allergies)
                        </p>
                    </div>

                    <div style="display: flex; gap: 10px; align-items: center; margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px;">
                        <a asp-action="Edit" asp-route-id="@pet.Id" class="btn ghost" style="flex: 1; text-align: center;">Edit</a>
                        <form asp-action="Delete" asp-route-id="@pet.Id" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="linkbtn" onclick="return confirm('Remove @pet.Name?')">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
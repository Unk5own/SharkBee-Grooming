@model IEnumerable<PetGrooming.Models.User>
@{ ViewBag.Title = "User Management"; }
<div class="card">
    <p>Manage Admin, Staff and Member accounts.</p>
    <form method="get" class="filters">
        <div class="field">
            <label for="search">Search</label>
            <input id="search" name="search" type="search" value="@ViewBag.Search" placeholder="Email or name" />
        </div>
        <div class="field">
            <label for="role">Role</label>
            <select id="role" name="role">
                <option value="">All roles</option>
                <option value="Admin" selected="@(ViewBag.Role as string == "Admin")">Admin</option>
                <option value="Staff" selected="@(ViewBag.Role as string == "Staff")">Staff</option>
                <option value="Member" selected="@(ViewBag.Role as string == "Member")">Member</option>
            </select>
        </div>
        <label class="check-inline">
            <input type="checkbox" name="showBlocked" value="true" @(ViewBag.ShowBlocked == true ? "checked" : "") />
            Show blocked
        </label>
        <div class="filter-actions">
            <button class="btn" type="submit">Filter</button>
            <a class="btn ghost" asp-action="Create">Create User</a>
        </div>
    </form>
</div>

@if (TempData["Info"] != null)
{
    <div class="info">@TempData["Info"]</div>
}

<table>
    <thead>
        <tr><th>Photo</th><th>Email</th><th>Name</th><th>Role</th><th>Status</th><th>Action</th></tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(user.PhotoURL))
                {
                    <img class="avatar" src="~/photos/users/@user.PhotoURL" alt="@user.Name" />
                }
                else
                {
                    <span class="avatar avatar-placeholder">@user.Name.Substring(0, 1).ToUpper()</span>
                }
            </td>
            <td>@user.Email</td>
            <td>@user.Name</td>
            <td>@user.Role</td>
            <td>@(user.Blocked ? "Blocked" : "Active")</td>
            <td>
                <a class="btn sm" asp-action="Edit" asp-route-email="@user.Email">Edit</a>
                @if (!user.Blocked)
                {
                    <form asp-action="Delete" asp-route-email="@user.Email" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="btn ghost sm" type="submit" onclick="return confirm('Block this account?')">Block</button>
                    </form>
                }
                else
                {
                    <form asp-action="Unblock" asp-route-email="@user.Email" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="btn sm" type="submit">Unblock</button>
                    </form>
                }
                <form asp-action="PermanentDelete" asp-route-email="@user.Email" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button class="btn danger sm" type="submit" onclick="return confirm('Permanently delete this account? This cannot be undone.')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@model PetGrooming.Models.LoginVM
@{ ViewBag.Title = "Login"; }
<div class="card narrow">
    <p>Admin, Groomer (Staff), and Member accounts use manual cookie authentication.</p>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>

        <label asp-for="Password"></label>
        <div class="pwd-wrap">
            <input asp-for="Password" autocomplete="current-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>

        <div class="form-links">
            <a asp-action="ForgotPassword">Forgot password?</a>
        </div>

        <label>Security check: <strong>@ViewBag.CaptchaQuestion</strong></label>
        <input asp-for="CaptchaAnswer" type="number" min="0" max="100" inputmode="numeric" />
        <span asp-validation-for="CaptchaAnswer" class="field-error"></span>

        <label class="choice"><input asp-for="RememberMe" /> Remember me</label>
        <button class="btn" type="submit">Login</button>
        <a class="btn ghost" asp-action="Register">Register</a>
    </form>
</div>
@section foot {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js"></script>
}

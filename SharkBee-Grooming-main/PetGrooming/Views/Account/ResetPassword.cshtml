@model PetGrooming.Models.SetNewPasswordVM
@{ ViewBag.Title = "Reset Password"; }
<div class="card narrow">
    <h2>Set a New Password</h2>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Password"></label>
        <div class="pwd-wrap">
            <input asp-for="Password" autocomplete="new-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span class="sub">At least 8 characters, with at least one letter and one number.</span>
        <span asp-validation-for="Password" class="field-error"></span>

        <label asp-for="Confirm"></label>
        <div class="pwd-wrap">
            <input asp-for="Confirm" autocomplete="new-password" />
            <button type="button" class="pwd-toggle">Show</button>
        </div>
        <span asp-validation-for="Confirm" class="field-error"></span>

        <button class="btn" type="submit">Reset Password</button>
        <a class="btn ghost" asp-action="Login">Back to Login</a>
    </form>
</div>
@section foot {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js"></script>
}

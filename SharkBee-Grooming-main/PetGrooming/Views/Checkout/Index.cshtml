@model CheckoutVM

<form asp-action="Confirm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <table>
        <thead>
            <tr>
                <th>Pet</th>
                <th>Service</th>
                <th>Groomer</th>
                <th>Date and Time</th>
                <th class="num">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr class="@(line.Unavailable ? "unavailable" : "")">
                    <td>
                        @line.Pet.Name
                        <span class="sub">@line.Pet.Breed</span>
                        @if (!string.IsNullOrWhiteSpace(line.Pet.Allergies) && line.Pet.Allergies != "None")
                        {
                            <span class="sub">Allergies: @line.Pet.Allergies</span>
                        }
                    </td>
                    <td>
                        @line.Service.Name
                        <span class="sub">@line.Service.DurationMinutes minutes</span>
                    </td>
                    <td>
                        @line.Staff.Name
                        <span class="sub">@line.Staff.Specialization</span>
                    </td>
                    <td>
                        @line.Item.SlotStart.ToString("ddd, d MMM yyyy")
                        <span class="sub">
                            @line.Item.SlotStart.ToString("h:mm tt") &ndash; @line.SlotEnd.ToString("h:mm tt")
                        </span>
                        @if (line.Unavailable)
                        {
                            <span class="pill cancelled">No longer available</span>
                        }
                    </td>
                    <td class="num">RM @line.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card">
        <div class="totals">
            <div><span>Subtotal</span> <span>RM @Model.Subtotal.ToString("N2")</span></div>
            <div><span>Discount</span> <span>RM @Model.Discount.ToString("N2")</span></div>
            <div class="grand"><span>Total</span> <span>RM @Model.Total.ToString("N2")</span></div>
        </div>
    </div>

    <div class="card">
        <label>Payment Method</label>

        <label class="choice stacked">
            <input type="radio" asp-for="Method" value="@PaymentMethod.Counter" checked>
            <span>
                <b>Pay at Counter</b>
                <span class="sub">Settle the full amount when you drop your pet off.</span>
            </span>
        </label>

        <label class="choice stacked @(ViewBag.CardAvailable == true ? "" : "disabled")">
            <input type="radio" asp-for="Method" value="@PaymentMethod.Stripe"
                   disabled="@(ViewBag.CardAvailable != true)">
            <span>
                <b>Pay Online by Card</b>
                @if (ViewBag.CardAvailable == true)
                {
                    <span class="sub">
                        Secure payment page hosted by Stripe. Test card 4242 4242 4242 4242.
                    </span>
                }
                else
                {
                    <span class="sub">Unavailable &mdash; card payments are not configured.</span>
                }
            </span>
        </label>
    </div>

    <div class="card">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" rows="3"
                  placeholder="Anything the groomer should know? Nervous around dryers, prefers a shorter trim..."></textarea>
        <span asp-validation-for="Notes" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn">Confirm Booking</button>
    <a href="/" class="btn ghost">Keep Browsing</a>
</form>

@section foot {
    <partial name="_ValidationScriptsPartial" />
}

@model Appointment

<div class="card">
    <h2 style="margin-top:0">Thank you, your booking is confirmed.</h2>
    <p>
        Your booking reference is <b>@Model.BookingRef</b>.
        Please arrive about ten minutes early so we can check your pet in.
    </p>
    <p class="sub">
        Booked on @Model.CreatedAt.ToString("d MMM yyyy, h:mm tt")
        &middot; Status <span class="pill @Model.Status.ToString().ToLower()">@Model.Status</span>
    </p>
</div>

<table>
    <thead>
        <tr>
            <th>Pet</th>
            <th>Service</th>
            <th>Groomer</th>
            <th>Date and Time</th>
            <th class="num">Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items.OrderBy(i => i.SlotStart))
        {
            <tr>
                <td>@item.Pet.Name<span class="sub">@item.Pet.Breed</span></td>
                <td>@item.Service.Name</td>
                <td>@item.Staff.Name</td>
                <td>
                    @item.SlotStart.ToString("ddd, d MMM yyyy")
                    <span class="sub">
                        @item.SlotStart.ToString("h:mm tt") &ndash; @item.SlotEnd.ToString("h:mm tt")
                    </span>
                </td>
                <td class="num">RM @item.UnitPrice.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

<div class="card">
    <div class="totals">
        <div><span>Subtotal</span> <span>RM @Model.Subtotal.ToString("N2")</span></div>
        <div><span>Discount</span> <span>RM @Model.Discount.ToString("N2")</span></div>
        <div class="grand"><span>Total</span> <span>RM @Model.Total.ToString("N2")</span></div>
    </div>
</div>

@{
    var payment = Model.Payments.FirstOrDefault();
}
@if (payment != null)
{
    <div class="card">
        <b>Payment</b>
        <p>
            @payment.Method &middot;
            <span class="pill @payment.Status.ToString().ToLower()">@payment.Status</span>
            &middot; RM @payment.Amount.ToString("N2")
        </p>
        @if (payment.Status == PaymentStatus.Pending)
        {
            <p class="sub">Please settle this amount at the counter on the day of your appointment.</p>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="card">
        <b>Your notes</b>
        <p>@Model.Notes</p>
    </div>
}

<a asp-action="Receipt" asp-route-id="@Model.Id" class="btn">Download E-Receipt (PDF)</a>
<a href="/MyAppointment/Index" class="btn ghost">View My Appointments</a>
<a href="/" class="btn ghost">Back to Home</a>

@model IEnumerable<Service>
@{
    ViewBag.Title = "Our Services";

    // The chips post back to this action, which understands categoryId only --
    // price sorting lives on the home page, whose action reads priceSort.
    ViewData["FilterUrl"] = "/Booking/Catalog";
    ViewData["ShowSort"] = false;
}

<p class="section-sub">
    Pick a service to book. You will choose the pet, the groomer and the time on
    the next step.
</p>

<partial name="_ServiceGrid" model="Model" />

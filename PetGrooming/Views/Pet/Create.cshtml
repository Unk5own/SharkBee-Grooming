@model PetGrooming.Models.PetVM
@{
    ViewBag.Title = "Add a Pet";
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card">
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="e.g. Milo">
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="Species"></label>
            <select asp-for="Species">
                <option value="Dog">Dog</option>
                <option value="Cat">Cat</option>
            </select>
        </div>

        <div>
            <label asp-for="Breed"></label>
            <input asp-for="Breed" placeholder="e.g. Poodle, Domestic Shorthair">
            <span asp-validation-for="Breed" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="BirthDate">Date of Birth</label>
            <input type="date" asp-for="BirthDate">
        </div>

        <div>
            <label asp-for="WeightKg">Weight (kg)</label>
            <input type="number" step="0.01" asp-for="WeightKg">
        </div>

        <div>
            <label asp-for="Allergies"></label>
            <input asp-for="Allergies" placeholder="e.g. Sensitive skin, Shampoo allergies">
        </div>

        <div>
            <label asp-for="Photos">Pet Photos (Select multiple)</label>
            <input type="file" asp-for="Photos" accept="image/*" multiple>
        </div>
    </div>

    <button type="submit" class="btn">Save Pet</button>
    <a asp-action="Index" class="btn ghost">Cancel</a>
</form>

@section foot {
    <partial name="_ValidationScriptsPartial" />
}
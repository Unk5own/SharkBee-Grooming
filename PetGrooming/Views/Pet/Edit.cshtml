@model PetGrooming.Models.PetVM
@{
    ViewBag.Title = "Edit Pet";
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    @* <input type="hidden" asp-for="ExistingPhotoURL" /> *@
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card">
        <div>
            <label>Current Photos (Select Primary)</label>
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">
                @foreach (var photo in Model.ExistingPhotos)
                {
                    <div style="text-align: center;">
                        <img src="~/Shared/image/@photo.PhotoURL" alt="@Model.Name" style="width: 140px; height: 140px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
                        <div>
                            <input type="radio" name="PrimaryPhotoURL" value="@photo.PhotoURL" id="img_@photo.PhotoURL" checked="@(photo.PhotoURL == Model.PrimaryPhotoURL)" />
                            <label for="img_@photo.PhotoURL">Primary</label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <label asp-for="Photos">Upload Additional Photos</label>
            <input type="file" asp-for="Photos" accept="image/*" multiple>
            <span class="sub">Select multiple files to add more reference photos.</span>
        </div>
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="e.g. Milo">
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="Species"></label>
            <select asp-for="Species">
                <option value="Dog">Dog</option>
                <option value="Cat">Cat</option>
            </select>
        </div>

        <div>
            <label asp-for="Breed"></label>
            <input asp-for="Breed" placeholder="e.g. Poodle, Domestic Shorthair">
            <span asp-validation-for="Breed" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="BirthDate">Date of Birth</label>
            <input type="date" asp-for="BirthDate">
            <span asp-validation-for="BirthDate" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="WeightKg">Weight (kg)</label>
            <input type="number" step="0.01" asp-for="WeightKg">
            <span asp-validation-for="WeightKg" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="Allergies"></label>
            <input asp-for="Allergies" placeholder="e.g. Sensitive skin, Shampoo allergies">
            <span asp-validation-for="Allergies" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" rows="3" placeholder="Additional details..."></textarea>
            <span asp-validation-for="Notes" class="field-validation-error"></span>
        </div>
    </div>

    <button type="submit" class="btn">Update Pet</button>
    <a asp-action="Index" class="btn ghost">Cancel</a>
</form>

@section foot {
    <partial name="_ValidationScriptsPartial" />
}
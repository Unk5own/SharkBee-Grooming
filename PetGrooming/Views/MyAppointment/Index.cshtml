@{
    var filter = ViewBag.Filter as string;
}

<div class="toolbar">
    <div class="daynav" id="tabs">
        <a asp-action="Index" class="@(filter == null ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-filter="upcoming" class="@(filter == "upcoming" ? "active" : "")">Upcoming only</a>
        <a asp-action="Index" asp-route-filter="past" class="@(filter == "past" ? "active" : "")">History only</a>
    </div>
</div>

<div id="results">
    <partial name="_Index" />
</div>

@section foot {
    <script>
        // Swap the list over AJAX; the links still work normally without JS.
        (function () {
            var tabs = document.getElementById('tabs');
            var results = document.getElementById('results');
            if (!tabs || !results) return;

            tabs.addEventListener('click', function (e) {
                var link = e.target.closest('a');
                if (!link) return;
                e.preventDefault();

                fetch(link.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        results.innerHTML = html;
                        history.replaceState(null, '', link.href);

                        var all = tabs.querySelectorAll('a');
                        for (var i = 0; i < all.length; i++) all[i].classList.remove('active');
                        link.classList.add('active');
                    });
            });
        })();
    </script>
}

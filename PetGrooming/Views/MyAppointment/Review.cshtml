@model ReviewVM
@{
    var item = (AppointmentItem)ViewBag.Item;
}

<div class="card">
    <p>
        How did <b>@item.Staff.Name</b> do with <b>@item.Pet.Name</b>?
        <span class="sub">
            @item.Service.Name on @item.SlotStart.ToString("d MMM yyyy")
        </span>
    </p>
</div>

<form asp-action="Review" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AppointmentItemId">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card">
        <label>Rating</label>

        @* Radios rather than script, so the rating still works without JavaScript
           and remains reachable by keyboard. *@
        <div class="stars">
            @for (int n = 5; n >= 1; n--)
            {
                <input type="radio" asp-for="Rating" value="@n" id="star@(n)">
                <label for="star@(n)" title="@n out of 5">&#9733;</label>
            }
        </div>
        <span asp-validation-for="Rating" class="field-validation-error"></span>

        <label asp-for="Comment" style="margin-top:14px">Comment</label>
        <textarea asp-for="Comment" rows="3"
                  placeholder="Anything you would like other pet owners to know?"></textarea>
        <span asp-validation-for="Comment" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn">
        @(item.Review == null ? "Submit Review" : "Update Review")
    </button>
    <a asp-action="Detail" asp-route-id="@item.AppointmentId" class="btn ghost">Back</a>
</form>

@section foot {
    <partial name="_ValidationScriptsPartial" />
}

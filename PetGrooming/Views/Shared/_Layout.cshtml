@{
    var pageTitle = ViewBag.Title as string;

    // Highlight whichever section the current page belongs to. Appointments and
    // the Schedule Board share the Appointment controller, so the action has to
    // be part of the test or both light up at once.
    var hereC = ViewContext.RouteData.Values["controller"] as string ?? "";
    var hereA = ViewContext.RouteData.Values["action"] as string ?? "";
    Func<string, string> on = c => string.Equals(hereC, c, StringComparison.OrdinalIgnoreCase) ? "on" : "";
    var onBoard = string.Equals(hereC, "Appointment", StringComparison.OrdinalIgnoreCase)
               && string.Equals(hereA, "Board", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "SharkBee Grooming" : pageTitle + " · SharkBee Grooming")</title>
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
</head>
<body>
    @if (TempData["Info"] != null)
    {
        <div class="info">@Html.Raw(TempData["Info"])</div>
    }

    <header class="topbar">
        <a class="brand" href="/">SharkBee Grooming</a>

        <nav class="mainnav">
            <a href="/" class="@on("Home")">Home</a>

            @if (User.IsInRole("Member"))
            {
                <a href="/Pet/Index" class="@on("Pet")">My Pets</a>
                <a href="/Checkout/Index" class="@on("Checkout")">Checkout</a>
                <a href="/MyAppointment/Index" class="@on("MyAppointment")">My Appointments</a>
                <a href="/Waitlist/Index" class="@on("Waitlist")">Waitlist</a>
            }

            @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
            {
                <a href="/Appointment/Index" class="@(on("Appointment") == "on" && !onBoard ? "on" : "")">Appointments</a>
                <a href="/Appointment/Board" class="@(onBoard ? "on" : "")">Schedule Board</a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin/Users" class="@on("AdminUsers")">Users</a>
                <a href="/Admin/Waitlist" class="@on("AdminWaitlist")">Waitlist</a>
                <a href="/Report/Dashboard" class="@on("Report")">Reports</a>
            }
        </nav>

        <div class="topbar-end">
            @if (User.Identity!.IsAuthenticated)
            {
                <span class="role">
                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Staff") ? "Groomer" : "Member")
                </span>
                <span class="who">@User.Identity.Name</span>
                <a class="btn ghost sm" href="/Account/Logout">Logout</a>
            }
            else
            {
                <a class="btn sm" href="/Account/Login">Login</a>
            }
        </div>
    </header>

    <main>
        @* A page with no title -- the landing page -- leads with its own hero instead. *@
        @if (!string.IsNullOrWhiteSpace(pageTitle))
        {
            <h1>@pageTitle</h1>
        }
        @RenderBody()
    </main>

    <footer>
        SharkBee Grooming &middot; BMIT2023 Assignment &middot; &copy; @DateTime.Today.Year
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("foot", false)
</body>
</html>

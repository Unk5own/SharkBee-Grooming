@inject IWebHostEnvironment en

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title &middot; Pawfect Grooming</title>
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
</head>
<body>
    @if (TempData["Info"] != null)
    {
        <div class="info">@Html.Raw(TempData["Info"])</div>
    }

    <header>
        <h1><a href="/">Pawfect Grooming</a></h1>

        @if (User.Identity!.IsAuthenticated)
        {
            <div class="who">
                <span class="role">
                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Staff") ? "Groomer" : "Member")
                </span>
                @User.Identity.Name
            </div>
        }
    </header>

    <nav>
        <a href="/">Home</a>

        @if (User.IsInRole("Member"))
        {
            <a href="/Checkout/Index">Checkout</a>
            <a href="/MyAppointment/Index">My Appointments</a>
        }

        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
        {
            <a href="/Appointment/Index">Appointments</a>
        }

        @if (User.IsInRole("Admin"))
        {
            <a href="/Report/Dashboard">Reports</a>
        }

        <div class="spacer"></div>

        @if (User.Identity.IsAuthenticated)
        {
            <a href="/Account/Logout">Logout</a>
        }
        else
        {
            <a href="/Account/Login">Login</a>
        }
    </nav>

    @if (en.IsDevelopment())
    {
        <div class="devbar">
            <b>DEV</b>
            <a href="/DevSeed/LoginAs?email=chloe@gmail.com">as Member</a>
            <a href="/DevSeed/LoginAs?email=aisyah@pawfect.com">as Groomer</a>
            <a href="/DevSeed/LoginAs?email=admin@pawfect.com">as Admin</a>
            <a href="/DevSeed/Logout">Sign out</a>
            <a href="/DevSeed/FakeCart">Fake cart</a>
            <a href="/DevSeed/ShowCart">Show cart</a>
            <span>&mdash; temporary, removed once Security and Booking are integrated</span>
        </div>
    }

    <main>
        <h1>@ViewBag.Title</h1>
        @RenderBody()
    </main>

    <footer>
        Pawfect Grooming &middot; BMIT2023 Assignment &middot; &copy; @DateTime.Today.Year
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("foot", false)
</body>
</html>

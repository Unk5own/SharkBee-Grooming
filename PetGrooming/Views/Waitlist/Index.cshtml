@model WaitlistVM
@{
    var entries = (List<Waitlist>)ViewBag.Entries;
}

<div class="card">
    <p>
        Fully booked on the day you wanted? Join the waitlist and we will email you
        the moment a matching slot is cancelled. Slots are offered oldest request
        first.
    </p>
</div>

<form asp-action="Join" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card">
        <div class="filters">
            <div>
                <label asp-for="PetId"></label>
                <select asp-for="PetId" asp-items="ViewBag.PetList">
                    <option value="">Choose a pet</option>
                </select>
                <span asp-validation-for="PetId" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="ServiceId"></label>
                <select asp-for="ServiceId" asp-items="ViewBag.ServiceList">
                    <option value="">Choose a service</option>
                </select>
                <span asp-validation-for="ServiceId" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="PreferredStaffEmail"></label>
                <select asp-for="PreferredStaffEmail" asp-items="ViewBag.StaffList">
                    <option value="">Any groomer</option>
                </select>
            </div>

            <div>
                <label asp-for="DesiredFrom"></label>
                <input type="date" asp-for="DesiredFrom">
                <span asp-validation-for="DesiredFrom" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="DesiredTo"></label>
                <input type="date" asp-for="DesiredTo">
                <span asp-validation-for="DesiredTo" class="field-validation-error"></span>
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn">Join Waitlist</button>
            </div>
        </div>
    </div>
</form>

<h2>Your Waitlist</h2>

@if (entries.Count == 0)
{
    <p class="empty">You are not on the waitlist for anything.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Pet</th>
                <th>Service</th>
                <th>Dates</th>
                <th>Groomer</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in entries)
            {
                <tr>
                    <td>@w.Pet.Name</td>
                    <td>@w.Service.Name</td>
                    <td>
                        @w.DesiredFrom.ToString("d MMM yyyy")
                        <span class="sub">to @w.DesiredTo.ToString("d MMM yyyy")</span>
                    </td>
                    <td>
                        @if (w.PreferredStaffEmail == null)
                        {
                            <span class="sub">Any groomer</span>
                        }
                        else
                        {
                            @w.PreferredStaffEmail
                        }
                    </td>
                    <td>
                        <span class="pill @(w.Status == WaitlistStatus.Notified ? "confirmed" : "pending")">
                            @w.Status
                        </span>
                        @if (w.NotifiedAt != null)
                        {
                            <span class="sub">@w.NotifiedAt.Value.ToString("d MMM, h:mm tt")</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Leave" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@w.Id">
                            <button type="submit" class="linkbtn">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section foot {
    <partial name="_ValidationScriptsPartial" />
}

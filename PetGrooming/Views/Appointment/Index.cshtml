@model IEnumerable<AppointmentItem>
@{
    var day = (DateOnly)ViewBag.Date;
    var summary = (Dictionary<AppointmentStatus, int>)ViewBag.Summary;
}

<div class="card">
    <form id="filters" method="get" asp-action="Index" class="filters">
        <div>
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="@day.ToString("yyyy-MM-dd")">
        </div>

        <div>
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<AppointmentStatus>())
                {
                    <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
                }
            </select>
        </div>

        @if (ViewBag.LockedToSelf != true)
        {
            <div>
                <label for="staff">Groomer</label>
                <select id="staff" name="staff" asp-items="ViewBag.StaffList">
                    <option value="">All groomers</option>
                </select>
            </div>
        }

        <div>
            <label for="name">Search</label>
            <input type="text" id="name" name="name" value="@ViewBag.Name"
                   placeholder="Pet, owner or booking reference">
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn">Apply</button>
            <a asp-action="Index" class="btn ghost">Reset</a>
        </div>
    </form>

    <div class="daynav">
        <a asp-action="Index" asp-route-date="@day.AddDays(-1).ToString("yyyy-MM-dd")">&larr; Previous day</a>
        <a asp-action="Index" asp-route-date="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")">Today</a>
        <a asp-action="Index" asp-route-date="@day.AddDays(1).ToString("yyyy-MM-dd")">Next day &rarr;</a>
    </div>
</div>

<div class="statusstrip">
    @foreach (var s in Enum.GetValues<AppointmentStatus>())
    {
        var n = summary.TryGetValue(s, out var c) ? c : 0;
        if (n > 0)
        {
            <span class="pill @s.ToString().ToLower()">@s @n</span>
        }
    }
</div>

<div id="results">
    <partial name="_Index" model="Model" />
</div>

@section foot {
    <script>
        // AJAX filtering: replace just the results table instead of reloading
        // the whole page. Falls back to a normal form submit without JavaScript.
        (function () {
            var form = document.getElementById('filters');
            var results = document.getElementById('results');
            if (!form || !results) return;

            function load() {
                var qs = new URLSearchParams(new FormData(form)).toString();
                var url = form.getAttribute('action') + '?' + qs;

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        results.innerHTML = html;
                        history.replaceState(null, '', url);
                    });
            }

            form.addEventListener('submit', function (e) { e.preventDefault(); load(); });
            form.addEventListener('change', load);
        })();
    </script>
}

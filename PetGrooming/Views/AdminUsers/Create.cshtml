@model PetGrooming.Models.UserCreateVM
@{ ViewBag.Title = "Create User"; }
<div class="card narrow-wide">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="field-error"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <label asp-for="Role"></label>
        <select asp-for="Role" id="role">
            <option value="Admin">Admin</option>
            <option value="Staff">Staff</option>
            <option value="Member">Member</option>
        </select>
        <span asp-validation-for="Role" class="field-error"></span>
        <div id="memberFields">
            <label asp-for="Phone"></label>
            <input asp-for="Phone" />
        </div>
        <div id="staffFields">
            <label asp-for="Specialization"></label>
            <input asp-for="Specialization" />
            <label asp-for="HireDate"></label>
            <input asp-for="HireDate" />
        </div>
        <button class="btn" type="submit">Create</button>
        <a class="btn ghost" asp-action="Index">Cancel</a>
    </form>
</div>
@section foot {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFields() {
            const role = document.getElementById('role').value;
            document.getElementById('memberFields').style.display = role === 'Member' ? 'block' : 'none';
            document.getElementById('staffFields').style.display = role === 'Staff' ? 'block' : 'none';
        }
        document.getElementById('role').addEventListener('change', toggleFields);
        toggleFields();
    </script>
}

@model IEnumerable<Waitlist>
@{
    // Same colours the member's own waitlist page uses, so a status reads the
    // same on both sides of the system.
    Func<WaitlistStatus, string> pill = s => s switch
    {
        WaitlistStatus.Notified => "confirmed",
        WaitlistStatus.Converted => "completed",
        WaitlistStatus.Expired => "cancelled",
        _ => "pending",
    };
}

@if (!Model.Any())
{
    <p class="empty">No waitlist entries match these filters.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Member</th>
                <th>Pet</th>
                <th>Service</th>
                <th>Wanted between</th>
                <th>Groomer</th>
                <th>Status</th>
                <th>Waiting since</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td>
                        <b>@w.Member.Name</b>
                        <span class="sub">@w.MemberEmail</span>
                    </td>
                    <td>@w.Pet.Name</td>
                    <td>@w.Service.Name</td>
                    <td>
                        @w.DesiredFrom.ToString("d MMM yyyy")
                        <span class="sub">to @w.DesiredTo.ToString("d MMM yyyy")</span>
                    </td>
                    <td>
                        @if (w.PreferredStaffEmail == null)
                        {
                            <span class="sub">Any groomer</span>
                        }
                        else
                        {
                            @w.PreferredStaffEmail
                        }
                    </td>
                    <td>
                        <span class="pill @pill(w.Status)">@w.Status</span>
                        @if (w.NotifiedAt != null)
                        {
                            <span class="sub">@w.NotifiedAt.Value.ToString("d MMM, h:mm tt")</span>
                        }
                    </td>
                    <td>
                        @w.CreatedAt.ToString("d MMM yyyy")
                        <span class="sub">@w.CreatedAt.ToString("h:mm tt")</span>
                    </td>
                    <td>
                        <div class="actions">
                            <a asp-action="Edit" asp-route-id="@w.Id" class="linkbtn plain">Edit</a>
                            <form asp-action="Delete" asp-route-id="@w.Id" method="post"
                                  onsubmit="return confirm('Remove this waitlist entry?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="linkbtn">Remove</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
